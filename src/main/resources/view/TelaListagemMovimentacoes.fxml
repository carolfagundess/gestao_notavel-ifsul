<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.gestaonotavel.ifsul.controller.TelaListagemMovimentacoesController">
    <top>
        <VBox style="-fx-background-color: #00897B; -fx-padding: 20;">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;" text="Fluxo de Caixa" />
                                <Label style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 13;" text="Histórico de entradas e saídas financeiras" />
                            </children>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 12;" text="SALDO ATUAL" />
                                <Label fx:id="lblSaldoAtual" style="-fx-text-fill: white; -fx-font-size: 32; -fx-font-weight: bold;" text="R$ 0,00" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0" style="-fx-background-color: #f5f7fa; -fx-padding: 25;" BorderPane.alignment="CENTER">
            <children>
                <TableView fx:id="tabelaFinanceira" style="-fx-background-color: white; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colunaData" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Data" />
                        <TableColumn fx:id="colunaTipo" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Tipo" />
                        <TableColumn fx:id="colunaDescricao" prefWidth="400.0" text="Descrição" />
                        <TableColumn fx:id="colunaValor" prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold;" text="Valor" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>