<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="700.0" stylesheets="@../styles/telaatividades.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.gestaonotavel.ifsul.controller.TelaCadastroTipoAtividadeController">
    <top>
        <VBox prefHeight="80.0" prefWidth="1000.0" style="-fx-background-color: #9C27B0; -fx-padding: 20;">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;" text="Gerenciar Tipos de Atividade" />
                <Label style="-fx-text-fill: #F3E5F5; -fx-font-size: 12;" text="Adicione ou remova os tipos de atividades (ex: Bingo, Rifa, Brechó)" />
            </children>
        </VBox>
    </top>
    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #212121;" text="Novo Tipo de Atividade" />
                <HBox alignment="BOTTOM_LEFT" spacing="15.0">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Nome do Tipo*" />
                                <TextField fx:id="txtNomeTipo" prefHeight="40.0" promptText="Ex: Bingo" style="-fx-font-size: 12; -fx-padding: 8;" />
                            </children>
                        </VBox>
                        <Button fx:id="btnSalvarTipo" minWidth="120.0" onAction="#handleSalvarTipoButtonAction" prefHeight="40.0" style="-fx-font-weight: bold; -fx-font-size: 12; -fx-padding: 10; -fx-background-color: #9C27B0; -fx-text-fill: white;" text="Salvar Novo" styleClass="button-action"/>
                    </children>
                </HBox>
                <Separator prefWidth="200.0" />
                <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #212121;" text="Tipos de Atividade Cadastrados" />
                <TableView fx:id="tabelaTiposAtividade" prefHeight="280.0" prefWidth="660.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colunaNome" prefWidth="520.0" text="Nome" />
                        <TableColumn fx:id="colunaAcoes" minWidth="100.0" prefWidth="138.0" style="-fx-alignment: CENTER;" text="Ações" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER_RIGHT" prefHeight="40.0" prefWidth="660.0">
                    <children>
                        <Button fx:id="btnFechar" minWidth="120.0" onAction="#handleFecharButtonAction" prefHeight="40.0" style="-fx-font-size: 12; -fx-padding: 10;" text="Fechar" styleClass="button-action"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>