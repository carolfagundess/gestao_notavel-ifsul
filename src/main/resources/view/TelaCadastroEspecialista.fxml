<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.gestaonotavel.ifsul.controller.TelaCadastroEspecialistaController">
    <top>
        <VBox prefHeight="80.0" prefWidth="600.0" style="-fx-background-color: #0097A7; -fx-padding: 20;">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" text="Novo Especialista" />
                <Label style="-fx-text-fill: #E0F7FA; -fx-font-size: 12;" text="Cadastre um profissional para realizar atendimentos" />
            </children>
        </VBox>
    </top>
    <center>
        <VBox spacing="15.0" style="-fx-padding: 20;" BorderPane.alignment="CENTER">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Nome Completo*" />
                        <TextField fx:id="txtNome" promptText="Ex: Dr. Roberto Alves" />
                    </children>
                </VBox>
                <HBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Especialidade*" />
                                <TextField fx:id="txtEspecialidade" promptText="Ex: Psicologia" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Registro Profissional (CRM/CRP)*" />
                                <TextField fx:id="txtRegistro" promptText="Ex: CRP-12345" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <HBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Valor da Sessão (R$)*" />
                                <TextField fx:id="txtValorSessao" promptText="0.00" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Duração (min)*" />
                                <TextField fx:id="txtDuracao" promptText="Ex: 50" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Máx. Pacientes*" />
                                <TextField fx:id="txtMaxPacientes" promptText="Ex: 20" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox prefHeight="20.0" VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#handleCancelarButtonAction" text="Cancelar" />
                        <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#handleSalvarButtonAction" style="-fx-background-color: #0097A7; -fx-text-fill: white; -fx-font-weight: bold;" text="Salvar Especialista" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>