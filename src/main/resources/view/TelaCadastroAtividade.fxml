<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="700.0" stylesheets="@../styles/telaatividades.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.gestaonotavel.ifsul.controller.TelaCadastroAtividadeController">
    <top>
        <VBox prefHeight="80.0" prefWidth="1000.0" style="-fx-background-color: #9C27B0; -fx-padding: 20;">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;" text="Cadastrar Nova Atividade" />
                <Label style="-fx-text-fill: #F3E5F5; -fx-font-size: 12;" text="Cadastre um novo evento, brechó, rifa ou outra atividade" />
            </children>
        </VBox>
    </top>
    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Nome da Atividade*" />
                        <TextField fx:id="txtNome" prefHeight="40.0" promptText="Ex: Bingo Beneficente de Natal" style="-fx-font-size: 12; -fx-padding: 8;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Tipo de Atividade*" />
                        <ComboBox fx:id="cbxTipoAtividade" prefHeight="40.0" prefWidth="700.0" promptText="Selecione o tipo" style="-fx-font-size: 12;" />
                    </children>
                </VBox>
                <HBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Data de Início*" />
                                <DatePicker fx:id="datePickerInicio" prefHeight="40.0" prefWidth="400.0" promptText="Selecione a data de início" style="-fx-font-size: 12;" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Data de Fim*" />
                                <DatePicker fx:id="datePickerFim" prefHeight="40.0" prefWidth="400.0" promptText="Selecione a data de término" style="-fx-font-size: 12;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Local*" />
                        <TextField fx:id="txtLocal" prefHeight="40.0" promptText="Ex: Sede da Associação, Salão Comunitário" style="-fx-font-size: 12; -fx-padding: 8;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Valor Arrecadado (Opcional)" />
                        <TextField fx:id="txtValorArrecadado" prefHeight="40.0" promptText="0.00" style="-fx-font-size: 12; -fx-padding: 8;" />
                    </children>
                </VBox>
                <VBox prefHeight="100.0" prefWidth="660.0" VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" prefHeight="40.0" prefWidth="660.0" spacing="15.0">
                    <children>
                        <Button fx:id="btnLimpar" minWidth="120.0" onAction="#handleLimparButtonAction" prefHeight="40.0" style="-fx-font-size: 12; -fx-padding: 10;" text="Limpar" />
                        <Button fx:id="btnCancelar" minWidth="120.0" onAction="#handleCancelarButtonAction" prefHeight="40.0" style="-fx-font-size: 12; -fx-padding: 10;" text="Cancelar" />
                        <Button fx:id="btnSalvar" minWidth="120.0" onAction="#handleSalvarButtonAction" prefHeight="40.0" style="-fx-font-weight: bold; -fx-font-size: 12; -fx-padding: 10; -fx-background-color: #9C27B0; -fx-text-fill: white;" text="Salvar Atividade" styleClass="button-action"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>