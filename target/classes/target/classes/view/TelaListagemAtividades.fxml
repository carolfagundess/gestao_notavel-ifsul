<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="768.0" prefWidth="1024.0" stylesheets="@../styles/telaatividades.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.gestaonotavel.ifsul.controller.TelaListagemAtividadesController">
    <top>
        <VBox style="-fx-background-color: #9C27B0; -fx-padding: 20;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;" text="Listagem de Atividades" />
                                <Label style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 13;" text="Gerencie todas as atividades" />
                            </children>
                        </VBox>
                    </children>
                    <padding><Insets bottom="10.0" left="20.0" right="20.0" top="10.0" /></padding>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 10 20 0 20;">
                    <children>
                        <TextField fx:id="txtBuscar" prefHeight="40.0" prefWidth="400.0" promptText="Buscar..." style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 6; -fx-padding: 10; -fx-font-size: 13;" />
                        <ComboBox fx:id="cbxFiltroTipo" prefHeight="40.0" prefWidth="180.0" promptText="Tipo" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 6; -fx-font-size: 13;" />
                        <DatePicker fx:id="datePickerFiltro" prefHeight="40.0" prefWidth="180.0" promptText="Data" style="-fx-font-size: 13;" />
                        <Button fx:id="btnLimparFiltros" onAction="#handleLimparFiltros" prefHeight="40.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 12; -fx-padding: 10 15; -fx-cursor: hand;" text="Limpar" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <children>
                                <Button fx:id="btnGerenciarTipos" onAction="#handleGerenciarTiposAction" prefHeight="40.0" style="-fx-background-color: rgba(255,255,255,0.9); -fx-text-fill: #9C27B0; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 6; -fx-padding: 10 25; -fx-cursor: hand;" text="Gerenciar Tipos" />
                                <Button fx:id="btnNovaAtividade" onAction="#handleNovaAtividadeAction" prefHeight="40.0" style="-fx-background-color: #E040FB; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 6; -fx-padding: 10 25; -fx-cursor: hand;" text="+ Nova Atividade" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <VBox spacing="15.0" style="-fx-background-color: #f5f7fa; -fx-padding: 25;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #333;" text="Atividades Agendadas" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotalRegistros" style="-fx-text-fill: #666; -fx-font-size: 12;" text="0 registros" />
                    </children>
                </HBox>
                <TableView fx:id="tabelaAtividades" style="-fx-background-color: white; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colunaNome" prefWidth="250.0" text="Nome" />
                        <TableColumn fx:id="colunaTipo" prefWidth="120.0" text="Tipo" />
                        <TableColumn fx:id="colunaDataInicio" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Início" />
                        <TableColumn fx:id="colunaDataFim" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Fim" />
                        <TableColumn fx:id="colunaLocal" prefWidth="150.0" text="Local" />
                        <TableColumn fx:id="colunaArrecadado" prefWidth="120.0" style="-fx-alignment: CENTER_RIGHT;" text="Valor" />
                        <TableColumn fx:id="colunaAcoes" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Ações" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" prefHeight="60.0" prefWidth="1024.0" style="-fx-background-color: #ECEFF1; -fx-border-color: #BDBDBD; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="10.0" left="20.0" right="20.0" top="10.0" /></padding>
            <children>
                <Button fx:id="btnFechar" minWidth="120.0" onAction="#handleFecharButtonAction" prefHeight="40.0" style="-fx-font-size: 12;" text="Fechar" />
            </children>
        </HBox>
    </bottom>
</BorderPane>