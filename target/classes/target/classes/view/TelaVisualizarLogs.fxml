<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.gestaonotavel.ifsul.controller.TelaVisualizarLogsController">
    <top>
        <VBox style="-fx-background-color: #455A64; -fx-padding: 15;">
            <Label text="Auditoria de Sistema" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabelaLogs" style="-fx-padding: 10;">
            <columns>
                <TableColumn fx:id="colunaData" prefWidth="180.0" text="Data/Hora" />
                <TableColumn fx:id="colunaUsuario" prefWidth="150.0" text="Usuário" />
                <TableColumn fx:id="colunaAcao" prefWidth="450.0" text="Ação Realizada" />
            </columns>
        </TableView>
    </center>
</BorderPane>