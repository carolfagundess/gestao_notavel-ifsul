<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="600.0" prefWidth="800.0" stylesheets="@../styles/telavoluntariado.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.gestaonotavel.ifsul.controller.TelaRelatorioVoluntariosController">
    <top>
        <VBox prefHeight="80.0" prefWidth="1000.0" style="-fx-background-color: #9C27B0; -fx-padding: 20;">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;" text="Relatório de Voluntariado" />
                <Label style="-fx-text-fill: #F3E5F5; -fx-font-size: 12;" text="Horas trabalhadas e créditos acumulados por cada responsável" />
            </children>
        </VBox>
    </top>
    <center>
        <VBox spacing="15.0" style="-fx-padding: 20;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #212121;" text="Resumo de Créditos por Responsável" />
                    </children>
                </HBox>
                <TableView fx:id="tabelaVoluntarios" prefHeight="450.0" prefWidth="760.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colunaNome" prefWidth="400.0" text="Nome do Responsável" />
                        <TableColumn fx:id="colunaHoras" prefWidth="180.0" text="Total de Horas" />
                        <TableColumn fx:id="colunaCreditos" prefWidth="180.0" text="Créditos Acumulados" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>