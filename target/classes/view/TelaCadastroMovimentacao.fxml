<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="600.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.gestaonotavel.ifsul.controller.TelaCadastroMovimentacaoController">
    <top>
        <VBox prefHeight="80.0" prefWidth="1000.0" style="-fx-background-color: #00897B; -fx-padding: 20;">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;" text="Lançamento Financeiro" />
                <Label style="-fx-text-fill: #E0F2F1; -fx-font-size: 12;" text="Registre uma entrada ou saída de recursos" />
            </children>
        </VBox>
    </top>
    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0" BorderPane.alignment="CENTER">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
            <children>
                <HBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Tipo de Movimento*" />
                                <ComboBox fx:id="cbxTipoMovimento" prefHeight="40.0" prefWidth="300.0" promptText="Entrada / Saída" style="-fx-font-size: 12;" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Data*" />
                                <DatePicker fx:id="datePickerData" prefHeight="40.0" prefWidth="300.0" style="-fx-font-size: 12;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Valor (R$)*" />
                        <TextField fx:id="txtValor" prefHeight="40.0" promptText="0.00" style="-fx-font-size: 12; -fx-padding: 8;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Forma de Pagamento*" />
                        <ComboBox fx:id="cbxFormaPagamento" prefHeight="40.0" prefWidth="700.0" promptText="Selecione..." style="-fx-font-size: 12;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Descrição / Observação*" />
                        <TextField fx:id="txtObservacao" prefHeight="40.0" promptText="Ex: Pagamento de Fonoaudióloga" style="-fx-font-size: 12; -fx-padding: 8;" />
                    </children>
                </VBox>
                <Separator prefWidth="200.0" />
                <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #757575;" text="Vínculos (Opcional)" />
                <HBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-text-fill: #212121;" text="Vincular a Especialista" />
                                <ComboBox fx:id="cbxEspecialista" prefHeight="40.0" prefWidth="320.0" promptText="Selecione se for pagamento..." style="-fx-font-size: 12;" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-text-fill: #212121;" text="Vincular a Atividade" />
                                <ComboBox fx:id="cbxAtividade" prefHeight="40.0" prefWidth="320.0" promptText="Selecione se for arrecadação..." style="-fx-font-size: 12;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox prefHeight="20.0" VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button fx:id="btnCancelar" minWidth="120.0" onAction="#handleCancelarButtonAction" prefHeight="40.0" style="-fx-font-size: 12;" text="Cancelar" />
                        <Button fx:id="btnSalvar" minWidth="120.0" onAction="#handleSalvarButtonAction" prefHeight="40.0" style="-fx-font-weight: bold; -fx-font-size: 12; -fx-background-color: #00897B; -fx-text-fill: white;" text="Salvar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>