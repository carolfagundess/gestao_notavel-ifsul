<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="650.0" prefWidth="700.0" stylesheets="@../styles/telavoluntariado.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.gestaonotavel.ifsul.controller.TelaRegistroParticipacaoController">
    <top>
        <VBox prefHeight="80.0" prefWidth="1000.0" style="-fx-background-color: #9C27B0; -fx-padding: 20;">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;" text="Registrar Voluntariado" />
                <Label style="-fx-text-fill: #F3E5F5; -fx-font-size: 12;" text="Registre as horas de trabalho voluntário de um responsável" />
            </children>
        </VBox>
    </top>
    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0" BorderPane.alignment="CENTER">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Atividade Realizada*" />
                        <ComboBox fx:id="cbxAtividade" prefHeight="40.0" prefWidth="700.0" promptText="Selecione a atividade" style="-fx-font-size: 12;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Responsável Voluntário*" />
                        <ComboBox fx:id="cbxResponsavel" prefHeight="40.0" prefWidth="700.0" promptText="Selecione o responsável" style="-fx-font-size: 12;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Função Desempenhada*" />
                        <TextField fx:id="txtFuncao" prefHeight="40.0" promptText="Ex: Venda de cartelas" style="-fx-font-size: 12; -fx-padding: 8;" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #212121;" text="Total de Horas Trabalhadas*" />
                        <TextField fx:id="txtHoras" prefHeight="40.0" prefWidth="200.0" promptText="Ex: 4.5" style="-fx-font-size: 12; -fx-padding: 8;" />
                    </children>
                </VBox>
                <Separator prefWidth="200.0" />
                <VBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-background-color: #F5F5F5; -fx-padding: 15; -fx-background-radius: 6;">
                    <children>
                        <Label style="-fx-font-size: 11; -fx-text-fill: #757575;" text="Créditos a serem gerados (R$ 10,00/hora)" />
                        <Label fx:id="lblCreditosGerados" styleClass="label-creditos" text="R$ 0,00" />
                    </children>
                </VBox>
                <VBox prefHeight="50.0" VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" prefHeight="40.0" prefWidth="660.0" spacing="15.0">
                    <children>
                        <Button fx:id="btnLimpar" minWidth="120.0" onAction="#handleLimparButtonAction" prefHeight="40.0" style="-fx-font-size: 12; -fx-padding: 10;" text="Limpar" />
                        <Button fx:id="btnCancelar" minWidth="120.0" onAction="#handleCancelarButtonAction" prefHeight="40.0" style="-fx-font-size: 12; -fx-padding: 10;" text="Cancelar" />
                        <Button fx:id="btnSalvar" minWidth="120.0" onAction="#handleSalvarButtonAction" prefHeight="40.0" style="-fx-font-weight: bold; -fx-font-size: 12; -fx-padding: 10; -fx-background-color: #9C27B0; -fx-text-fill: white;" text="Registrar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>